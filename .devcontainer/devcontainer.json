{
  "name": "Portfolio Dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && cd web && npm install",
  "postAttachCommand": {
    "app": "./dev.sh"
  },
  "portsAttributes": {
    "3000": { "label": "Web app", "onAutoForward": "openPreview" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },
  "forwardPorts": [3000, 8000]
}
