# Google Gemini API Configuration
# Copy this file to .env and replace with your actual API key
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Note: Replace 'your_gemini_api_key_here' with your actual Google Gemini API token
# You can get a free API token by:
# 1. Going to https://aistudio.google.com/
# 2. Signing in with your Google account
# 3. Creating a new API key
# 4. Copying the token and replacing the value above

# SERPapi Configuration (for Sentiment Analysis)
# Get your API key from: https://serpapi.com/
SERP_API_KEY=your_serpapi_key_here

# Note: Replace 'your_serpapi_key_here' with your actual SERPapi token
# You can get a free API token by:
# 1. Going to https://serpapi.com/
# 2. Signing up for an account
# 3. Creating a new API key from the dashboard
# 4. Copying the token and replacing the value above

# Finnhub Configuration (fallback for stock prices when Yahoo Finance is down/rate-limited)
# Get your free API key from: https://finnhub.io/
FINN_API_KEY=your_finnhub_api_key_here

# Note: The free tier's real-time quote endpoint is used to value the portfolio
# when Yahoo Finance is unavailable. Historical charts still rely on Yahoo.

# ── API server (optional) ─────────────────────────────────────────────
# Key used to sign session cookies (32+ characters). If unset, one is generated on
# first run and stored in data/.session_secret. Required in production / on Vercel:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# SESSION_SECRET=

# Session cookies are Secure-only automatically over HTTPS. 1 forces on, 0 forces off.
# COOKIE_SECURE=

# Password for the admin account created on a fresh install. If unset, a random
# password is printed to the API console once.
# ADMIN_PASSWORD=

# Set to 0 to close public sign-up (admins can still add users in Settings → Users).
# ALLOW_SIGNUP=1

# Set to 1 only behind a proxy that sets X-Forwarded-For (rate limits use the client IP).
# TRUST_PROXY=0

# ── Web app (optional) ────────────────────────────────────────────────
# Where the Next.js server proxies /api/* requests (default http://127.0.0.1:8000).
# Next.js does not read this file: set API_URL in your shell or in web/.env.local.

# ── Password reset email (optional) ───────────────────────────────────
# Without SMTP_HOST, reset links are printed to the API server's console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character app password from myaccount.google.com/apppasswords>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Portfolio Dashboard <you@example.com>

# Public address of the web app, used to build links in emails.
# APP_URL=http://localhost:3000
